{
  "name": "code-complexity-guard",
  "version": "1.0.0",
  "description": "Warns when a single Claude edit touches more than a configurable number of lines (default: 200). Large edits often signal hallucination or unintended scope creep.",
  "author": "hookpm",
  "license": "MIT",
  "event": "PostToolUse",
  "matcher": {
    "tool_name": "^(Write|Edit)$"
  },
  "handler": {
    "type": "command",
    "command": "python3 complexity.py",
    "async": false
  },
  "capabilities": ["side-effects-only"],
  "tags": ["code-quality", "developer-experience", "safety", "complexity"],
  "permissions": {
    "network": { "allowed": false, "domains": [] },
    "filesystem": { "read": ["*"], "write": [] },
    "env_vars": ["COMPLEXITY_GUARD_MAX_LINES"],
    "spawns_processes": false
  },
  "requires": {
    "os": ["darwin", "linux", "windows"],
    "shell": ["bash", "zsh", "sh"]
  },
  "security": {
    "sandbox_level": "static-analysis",
    "reviewed": false,
    "review_date": null,
    "signed": false,
    "signed_by": null,
    "signature": null
  }
}
