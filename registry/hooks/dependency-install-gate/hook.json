{
  "name": "dependency-install-gate",
  "version": "1.0.0",
  "description": "Blocks npm install, pip install, yarn add, and pnpm add commands unless the package is on an explicit allow-list or the gate is bypassed. Prevents supply-chain attacks and typosquatting.",
  "author": "hookpm",
  "license": "MIT",
  "event": "PreToolUse",
  "matcher": {
    "tool_name": "^Bash$"
  },
  "handler": {
    "type": "command",
    "command": "python3 gate.py",
    "async": false
  },
  "capabilities": ["block"],
  "tags": ["security", "supply-chain", "npm", "pip", "dependencies"],
  "permissions": {
    "network": { "allowed": false, "domains": [] },
    "filesystem": { "read": ["*"], "write": [] },
    "env_vars": ["INSTALL_GATE_ALLOW", "INSTALL_GATE_ALLOWLIST_FILE"],
    "spawns_processes": false
  },
  "requires": {
    "os": ["darwin", "linux"],
    "shell": ["bash", "zsh", "sh"]
  },
  "security": {
    "sandbox_level": "static-analysis",
    "reviewed": false,
    "review_date": null,
    "signed": false,
    "signed_by": null,
    "signature": null
  }
}
